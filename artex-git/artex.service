[Unit]
Description=ARTEX autonomous penetration testing daemon
Documentation=https://github.com/jiwoochris/artex-global
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=artex
Group=artex
WorkingDirectory=/var/lib/artex
ExecStart=/usr/bin/artex -addr 127.0.0.1:8787 -proxy 127.0.0.1:8788 -data /var/lib/artex/data
Restart=on-failure
RestartSec=5s

# Environment configuration
Environment=HOME=/var/lib/artex
Environment=ARTEX_CONFIG=/etc/artex/config.json
Environment=ARTEX_SKILL_DIR=/usr/share/artex/skills
EnvironmentFile=-/etc/artex/artex.env

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=artex

# Sandboxing & Hardening
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/artex
ReadOnlyPaths=/etc/artex
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid

RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes

PrivateIPC=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
KeyringMode=private
UMask=0027

SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target

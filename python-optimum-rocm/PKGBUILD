# Maintainer: Wuxxin <wuxxin@example.com>

pkgname=python-optimum-rocm
_pkgname=optimum
pkgver=2.3.0
pkgrel=1
pkgdesc='Accelerated inference and training with Hugging Face Optimum (with ROCm support)'
arch=('any')
url='https://github.com/huggingface/optimum'
license=('Apache-2.0')
depends=(
    'python'
    'python-huggingface-hub'
    'python-numpy'
    'python-optimum-amd'
    'python-packaging'
    'python-pytorch-rocm'
    'python-onnx'
    'python-transformers'
)
makedepends=(
    'python-build'
    'python-installer'
    'python-setuptools'
    'python-wheel'
)
optdepends=(
    'python-datasets'
    'python-evaluate'
    'python-onnx'
    'python-onnxruntime'
)
provides=("python-optimum=${pkgver}" "python-optimum-onnx")
conflicts=('python-optimum' 'python-optimum-onnx')
source=("https://files.pythonhosted.org/packages/source/${_pkgname::1}/${_pkgname}/${_pkgname}-${pkgver}.tar.gz")
sha256sums=('aa96ad535a5cec68d12c6372574125452284632fe13699633a61e8bbfb09c4df')

build() {
    cd "${_pkgname}-${pkgver}"
    python -m build --wheel --no-isolation
}

package() {
    cd "${_pkgname}-${pkgver}"
    python -m installer --destdir="${pkgdir}" dist/*.whl
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}

pkgname=(mlc-llm python-mlc-llm python-tvm-ffi-mlc)
pkgver=0.20.0.qwen35.r1916.gfeb82c99
pkgrel=13
pkgdesc="Universal LLM deployment engine via ML compilation (ROCm & Vulkan, qwen3_5 fork)"
arch=('x86_64')
url="https://github.com/alansrobotlab2/mlc-llm"
license=('Apache-2.0')
makedepends=('cmake' 'ninja' 'git' 'python-build' 'python-installer' 'python-scikit-build-core' 'rocm-hip-sdk' 'vulkan-headers' 'llvm' 'cython' 'python-setuptools-scm' 'rust')
source=("mlc-llm::git+https://github.com/alansrobotlab2/mlc-llm.git#commit=feb82c99"
        "hipblas-rocm72.patch"
        "hipblas-cc-rocm72.patch"
        "spirv-vulkan-runtime.patch"
        "rocm-gfx1100-isa.patch"
        "llvm-nonan-false.patch"
        "rocm-thread-cap-512.patch")
sha256sums=('af5749f087978829680ef1a43cbe549b77d3dc6c6e98701d0e9ef1823f91991a'
            '1b11c703801909447a09b25b0cf76ef3d378e8a206076a55c94f66fde7f75a9c'
            '7c1f14534fe72e66581f2ab4a57ad0b61d1b08b0d4fc759487ed7ce2ea05b9a8'

pkgver() {
    cd "${srcdir}/mlc-llm"
    printf "0.20.0.qwen35.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=8 HEAD)"
}

prepare() {
    cd "${srcdir}/mlc-llm"
    # Recursively update submodules (fork's .gitmodules points 3rdparty/tvm to alansrobotlab2/relax.git)
    git submodule update --init --recursive

    # Fix hipblas API for ROCm 7.2 (hipblasDatatype_t → hipDataType, add GetHipBlasComputeType)
    cd 3rdparty/tvm
    patch -Np1 -i "${srcdir}/hipblas-rocm72.patch"
    patch -Np1 -i "${srcdir}/hipblas-cc-rocm72.patch"
    patch -Np1 -i "${srcdir}/spirv-vulkan-runtime.patch"
    patch -Np1 -i "${srcdir}/rocm-gfx1100-isa.patch"
    patch -Np1 -i "${srcdir}/llvm-nonan-false.patch"
    patch -Np1 -i "${srcdir}/rocm-thread-cap-512.patch"
    cd "${srcdir}/mlc-llm"
}

build() {
    cd "${srcdir}/mlc-llm"

    # --- Step 1: Build TVM from fork's vendored relax fork ---
    msg "Building TVM (alansrobotlab2/relax) from 3rdparty/tvm..."
    mkdir -p 3rdparty/tvm/build

    cat > 3rdparty/tvm/build/config.cmake << 'CMAKEEOF'
set(CMAKE_BUILD_TYPE RelWithDebInfo)
set(USE_ROCM ON)
set(USE_HIPBLAS ON)
set(USE_CUTLASS OFF)
set(USE_CUDA OFF)
set(USE_VULKAN ON)
set(USE_OPENCL OFF)
set(USE_METAL OFF)
set(USE_LLVM "/opt/rocm/llvm/bin/llvm-config --link-static")
set(USE_FLASHINFER OFF)
set(USE_GTEST OFF)
set(USE_RPC OFF)
CMAKEEOF

    cmake -S 3rdparty/tvm -B 3rdparty/tvm/build -G Ninja
    ninja -C 3rdparty/tvm/build

    # --- Step 2: Build mlc-llm C++ (links against the TVM built above) ---
    msg "Building mlc-llm C++..."
    cmake -B build -G Ninja -DTVM_SOURCE_DIR=3rdparty/tvm -DCMAKE_SHARED_LINKER_FLAGS=-lonig
    ninja -C build

    # --- Step 3: Build Python wheel (no scikit-build-core; C++ already built) ---
    msg "Building Python wheel..."
    python -m build --wheel --no-isolation

    # --- Step 4: Stage the wheel for package splitting ---
    rm -rf "${srcdir}/stage"
    mkdir -p "${srcdir}/stage"
    python -m pip install --root="${srcdir}/stage" --no-deps --ignore-installed --break-system-packages dist/*.whl

    # --- Step 5: Build tvm-ffi Python package from vendored submodule ---
    msg "Building tvm-ffi..."
    cd "${srcdir}/mlc-llm/3rdparty/tvm/3rdparty/tvm-ffi"
    SKBUILD_CMAKE_ARGS="-DTVM_FFI_BUILD_PYTHON_MODULE=ON;-DTVM_FFI_BUILD_TESTS=OFF" python -m build --wheel --no-isolation
}

package_mlc-llm() {
    pkgdesc="Universal LLM deployment engine (shared libraries and executables)"
    depends=('rocm-hip-sdk' 'vulkan-icd-loader' 'llvm-libs' 'libbacktrace' 'oniguruma')
    provides=('libmlc_llm.so' 'libtvm_runtime.so' 'libtvm.so' 'libtvm_ffi.so')
    conflicts=('tvm')

    cd "${srcdir}/stage"

    # Install binaries
    if [ -d usr/bin ]; then
        install -d "${pkgdir}/usr/bin"
        cp -a --no-preserve=ownership usr/bin/* "${pkgdir}/usr/bin/"
    fi

    # Install shared libraries
    install -d "${pkgdir}/usr/lib"

    # Find .so files from the wheel's site-packages (if any built via scikit-build-core)
    find usr/lib/python*/site-packages/mlc_llm/ -name "*.so" \
        -exec install -Dm755 {} "${pkgdir}/usr/lib/" \; 2>/dev/null || true

    # Copy .so files from mlc-llm C++ build directory
    find "${srcdir}/mlc-llm/build" -maxdepth 2 -name "*.so" \
        -exec install -Dm755 {} "${pkgdir}/usr/lib/" \; 2>/dev/null || true

    # Copy .so files from TVM build directory
    find "${srcdir}/mlc-llm/3rdparty/tvm/build" -maxdepth 1 -name "*.so" \
        -exec install -Dm755 {} "${pkgdir}/usr/lib/" \; 2>/dev/null || true
}

package_python-mlc-llm() {
    pkgdesc="Python bindings for MLC-LLM"
    depends=('mlc-llm' 'python' 'python-numpy' 'python-pytorch' 'python-transformers' 'python-fastapi' 'python-openai' 'python-safetensors' 'python-sentencepiece' 'python-tqdm' 'python-tiktoken' 'python-shortuuid' 'python-ml-dtypes' 'uvicorn' 'python-flashinfer-rocm' 'python-msgpack' 'python-psutil' 'python-peft' 'python-prompt_toolkit' 'python-aiohttp' 'python-datasets' 'python-pytest' 'python-tvm-ffi-mlc')
    provides=('python-tvm')
    conflicts=('python-tvm')

    cd "${srcdir}/stage"

    # Install mlc_llm CLI entry point
    install -d "${pkgdir}/usr/bin"
    cat > "${pkgdir}/usr/bin/mlc_llm" << 'EOF'
#!/usr/bin/env python
"""MLC LLM CLI entry point."""
from mlc_llm.__main__ import main
main()
EOF
    chmod 755 "${pkgdir}/usr/bin/mlc_llm"

    # Copy site-packages
    install -d "${pkgdir}/usr/lib"
    cp -a --no-preserve=ownership usr/lib/python* "${pkgdir}/usr/lib/"

    # Remove compiled shared libraries from python package and symlink them to the system libraries
    local py_ver
    py_ver=$(python -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')")
    local site_pkgs="${pkgdir}/usr/lib/python${py_ver}/site-packages/mlc_llm"

    rm -f "${site_pkgs}"/*.so

    # Symlink to system libraries (from mlc-llm package, resolved at install time)
    ln -sr "${pkgdir}/usr/lib/libmlc_llm.so" "${site_pkgs}/libmlc_llm.so"
    ln -sr "${pkgdir}/usr/lib/libtvm_runtime.so" "${site_pkgs}/libtvm_runtime.so"
    ln -sr "${pkgdir}/usr/lib/libmlc_llm_module.so" "${site_pkgs}/libmlc_llm_module.so"

    # Copy TVM python bindings to site-packages
    cp -a --no-preserve=ownership "${srcdir}/mlc-llm/3rdparty/tvm/python/tvm" \
        "${pkgdir}/usr/lib/python${py_ver}/site-packages/"

    # Symlink libtvm_runtime.so and libtvm_compiler.so to tvm/lib/ so TVM finds them
    install -d "${pkgdir}/usr/lib/python${py_ver}/site-packages/tvm/lib"
    ln -sr "${pkgdir}/usr/lib/libtvm_runtime.so" \
        "${pkgdir}/usr/lib/python${py_ver}/site-packages/tvm/lib/libtvm_runtime.so"
    ln -sr "${pkgdir}/usr/lib/libtvm_compiler.so" \
        "${pkgdir}/usr/lib/python${py_ver}/site-packages/tvm/lib/libtvm_compiler.so"
}

package_python-tvm-ffi-mlc() {
    pkgdesc="Open ABI and FFI for Machine Learning Systems (MLC Relax Fork)"
    depends=('python' 'python-typing_extensions' 'libbacktrace')
    provides=('python-tvm-ffi')
    conflicts=('python-tvm-ffi')

    cd "${srcdir}/mlc-llm/3rdparty/tvm/3rdparty/tvm-ffi"
    python -m pip install --root="${pkgdir}" --no-deps --ignore-installed --break-system-packages dist/*.whl

    local py_ver
    py_ver=$(python -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')")
    local ffi_lib_dir="${pkgdir}/usr/lib/python${py_ver}/site-packages/tvm_ffi"

    # Remove the duplicate build of libtvm_ffi.so and symlink to system libtvm_ffi.so
    rm -f "${ffi_lib_dir}/lib/libtvm_ffi.so"
    install -d "${ffi_lib_dir}/lib"
    ln -sr "${pkgdir}/usr/lib/libtvm_ffi.so" "${ffi_lib_dir}/lib/libtvm_ffi.so"
}

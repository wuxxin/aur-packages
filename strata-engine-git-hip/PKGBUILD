# Maintainer: Wuxxin <wuxxin@gmail.com>

pkgname=strata-engine-git-hip
pkgver=0.2.21.1.r0.g2af30cc
pkgrel=1
pkgdesc="Strata inference engine for large MoE models (Qwen3.8-Flash-Next, DeepSeek-V4.1-Flash, Qwen3.6-35B) with native HIP acceleration"
arch=('x86_64')
url="https://github.com/Niko1221/Strata"
license=('MIT' 'Apache-2.0')
options=('!lto' '!debug' '!buildflags')
makedepends=('cmake' 'git' 'ninja' 'rocm-toolchain' 'rocm-hip-sdk' 'patchelf')
depends=(
    'hip-runtime-amd' 'hipblas' 'hipblaslt' 'rocblas' 'openblas' 'gcc-libs' 'zstd'
    'python' 'python-numpy' 'python-jinja' 'python-regex' 'python-yaml'
    'python-tqdm' 'python-requests' 'python-pillow' 'python-psutil' 'python-rich' 'python-jsonschema'
)
optdepends=(
    'cmake: recompile the engine when your GPU is outside the architectures built here'
    'ninja: recompile the engine when your GPU is outside the architectures built here'
    'gcc: recompile the engine when your GPU is outside the architectures built here'
    'nodejs: run npx-based MCP servers from the web chat'
)
provides=('strata-engine' 'strata-engine-git' 'strata-engine-git-ggml-hip')
conflicts=('strata-engine' 'strata-engine-git' 'strata-engine-git-ggml-hip')
replaces=('strata-engine-git-ggml-hip')

source=(
    "Strata::git+https://github.com/Niko1221/Strata.git"
    "strata-version-commit.patch"
    "strata-clear-cache.patch"
)
sha256sums=('SKIP'
            'cf9175f62c811909c1eae685ae4d1732a719e7ae20d4b6d291579388dbdbdc57'
            '1f7ce8c6f2ca64bd19eb4cc9714ebfb3c8bf1298c8d1713d289612bcaea58e32')

pkgver() {
    cd "${srcdir}/Strata"
    git describe --long --tags --abbrev=7 | sed -E 's/^v//; s/([^-]*-g)/r\1/; s/-/./g'
}

prepare() {
    # Strata 0.2.16 layout: engine/, terminal/. The release engine links no ggml at all, so there is no system-ggml integration.
    cd "${srcdir}/Strata"
    patch -p1 <"${srcdir}/strata-version-commit.patch"
    patch -p1 <"${srcdir}/strata-clear-cache.patch"
}

build() {
    export PATH="/usr/bin:$PATH"
    export ROCM_HOME="${ROCM_HOME:-/opt/rocm}"
    export ROCM_PATH="$ROCM_HOME"
    export HIP_ROOT_DIR="$ROCM_HOME"
    export HIP_PLATFORM=amd
    export CC=gcc
    export CXX=g++
    unset CFLAGS CXXFLAGS LDFLAGS CPPFLAGS

    # --- Architecture resolution: Strata HIP kernels target AMD RDNA wave32 GPUs (gfx1010-gfx1034, gfx1100-gfx1152, gfx1200-gfx1201) ---
    local _BLACKLIST="gfx1103"
    local _GPU_TARGETS
    _GPU_TARGETS=$(rocm-supported-gfx | tr ';' '\n' |
        grep -vFf <(echo "${_BLACKLIST//;/\\n}") | tr '\n' ';' | sed 's/;$//')
    if [[ -n "$AMDGPU_TARGETS" ]]; then _GPU_TARGETS="$AMDGPU_TARGETS"; fi
    if [[ -z "$_GPU_TARGETS" ]]; then _GPU_TARGETS="gfx1030"; fi

    local _STRATA_WHITELIST="gfx1100;gfx1101;gfx1102;gfx1103;gfx1150;gfx1151;gfx1152;gfx1200;gfx1201;gfx1010;gfx1011;gfx1012;gfx1030;gfx1031;gfx1032;gfx1034"
    local _STRATA_HIP_ARCHS=""
    local _a
    for _a in ${_GPU_TARGETS//;/ }; do
        if [[ ";${_STRATA_WHITELIST};" == *";${_a};"* ]]; then
            _STRATA_HIP_ARCHS="${_STRATA_HIP_ARCHS:+${_STRATA_HIP_ARCHS};}${_a}"
        fi
    done
    if [[ -z "$_STRATA_HIP_ARCHS" ]]; then
        _STRATA_HIP_ARCHS="gfx1100;gfx1201"
    fi

    # --- Build Strata Engine + shape engines (HIP); no ggml/llama linked ---
    echo "--- Building Strata Engine & Shape Engines (HIP) for ${_STRATA_HIP_ARCHS} ---"
    cmake -B build_strata_hip -S Strata/engine -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX="/usr" \
        -DCMAKE_HIP_COMPILER=/opt/rocm/bin/amdclang++ \
        -DCMAKE_HIP_ARCHITECTURES="${_STRATA_HIP_ARCHS}" \
        -DSTRATA_ENABLE_HIP=ON \
        -DSTRATA_ENABLE_CUDA=OFF \
        -DSTRATA_BUILD_HY4=ON \
        -DSTRATA_BUILD_INKLING=ON \
        -DSTRATA_BUILD_INKLING2=ON \
        -DSTRATA_BUILD_TESTS=OFF \
        -DCMAKE_SKIP_RPATH=ON
    cmake --build build_strata_hip --target \
        strata strata-q36 strata-inkling strata-hy4 \
        strata-gguf strata-dequant strata-plan

    # --- Build Strata Vision (HIP) — own tower, no llama/mtmd/ggml ---
    echo "--- Building Strata Vision (HIP) ---"
    cmake -B build_strata_vision_hip -S Strata/terminal/tools/vision -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX="/usr" \
        -DCMAKE_HIP_COMPILER=/opt/rocm/bin/amdclang++ \
        -DSTRATA_VISION_HIP=ON \
        -DSTRATA_VISION_HIP_ARCHS="${_STRATA_HIP_ARCHS}" \
        -DSTRATA_PORTABLE=OFF
    cmake --build build_strata_vision_hip --target strata-vision

    # --- Build Strata Vision (CPU fallback) ---
    echo "--- Building Strata Vision (CPU fallback) ---"
    cmake -B build_strata_vision_cpu -S Strata/terminal/tools/vision -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX="/usr" \
        -DSTRATA_VISION_HIP=OFF \
        -DSTRATA_VISION_CUDA=OFF \
        -DSTRATA_PORTABLE=OFF
    cmake --build build_strata_vision_cpu --target strata-vision
}

package() {
    local _share="${pkgdir}/usr/share/strata"
    local _engine="${pkgdir}/usr/lib/strata/engine"
    install -d "${_share}" "${_engine}" "${pkgdir}/usr/bin"

    # --- Read-only application tree (terminal/, engine/, tools/) ---
    cd "${srcdir}/Strata"
    cp -r terminal engine tools "${_share}/"
    install -Dm644 setup.sh LICENSE "${_share}/"
    # --- Compiled engine, shape engines, CLI tools, and vision binaries ---
    local _bin _src_bin
    for _bin in strata strata-q36 strata-hy4 strata-gguf strata-dequant strata-plan; do
        install -Dm755 "${srcdir}/build_strata_hip/${_bin}" "${_engine}/${_bin}"
        patchelf --remove-rpath "${_engine}/${_bin}" 2>/dev/null || true
    done
    if [[ -x "${srcdir}/build_strata_hip/src/inkling2/strata-inkling" ]]; then
        _src_bin="${srcdir}/build_strata_hip/src/inkling2/strata-inkling"
    else
        _src_bin="${srcdir}/build_strata_hip/strata-inkling"
    fi
    install -Dm755 "${_src_bin}" "${_engine}/strata-inkling"
    patchelf --remove-rpath "${_engine}/strata-inkling" 2>/dev/null || true
    install -Dm755 "${srcdir}/build_strata_vision_hip/bin/strata-vision-hip" "${_engine}/strata-vision-hip"
    patchelf --remove-rpath "${_engine}/strata-vision-hip" 2>/dev/null || true
    install -Dm755 "${srcdir}/build_strata_vision_cpu/bin/strata-vision" "${_engine}/strata-vision"
    patchelf --remove-rpath "${_engine}/strata-vision" 2>/dev/null || true

    # --- Generate BUILD.json metadata ---
    local _STRATA_WHITELIST="gfx1100;gfx1101;gfx1102;gfx1103;gfx1150;gfx1151;gfx1152;gfx1200;gfx1201;gfx1010;gfx1011;gfx1012;gfx1030;gfx1031;gfx1032;gfx1034"
    local _STRATA_HIP_ARCHS=""
    local _tgt="${GPU_TARGETS:-}"
    if [[ -z "$_tgt" ]]; then
        _tgt=$(rocm-supported-gfx 2>/dev/null || echo "gfx1100;gfx1201")
    fi
    local _a
    for _a in ${_tgt//;/ }; do
        if [[ ";${_STRATA_WHITELIST};" == *";${_a};"* ]]; then
            _STRATA_HIP_ARCHS="${_STRATA_HIP_ARCHS:+${_STRATA_HIP_ARCHS};}${_a}"
        fi
    done
    if [[ -z "$_STRATA_HIP_ARCHS" ]]; then
        _STRATA_HIP_ARCHS="gfx1100;gfx1201"
    fi

    cd "${_share}/terminal"
    PYTHONDONTWRITEBYTECODE=1 /usr/bin/python - "${_STRATA_HIP_ARCHS}" "${_engine}/BUILD.json" <<'PYEOF'
import json, sys
sys.path.insert(0, ".")
import setup

archs = [a.strip() for a in sys.argv[1].replace(",", ";").split(";") if a.strip()]
meta = {
    "source": "local-hip",
    "backend": "hip",
    "version": setup.source_version(),
    "archs": archs,
    "vision": "gpu",
    "vision_cpu": "strata-vision",
    "vision_gpu": "strata-vision-hip",
    "vision_archs": archs,
    "lib_dirs": ["/opt/rocm/lib"],
    "src": setup.source_hash(setup.ENGINE_SOURCES),
    "vision_src": setup.source_hash(setup.VISION_SOURCES),
}
with open(sys.argv[2], "w", encoding="utf-8") as f:
    json.dump(meta, f, indent=1)
PYEOF

    echo "${pkgver}-${pkgrel}" >"${_share}/PKG_VERSION"

    # --- Launcher script ---
    cat >"${pkgdir}/usr/bin/strata" <<'EOF'
#!/bin/bash
# Launcher for the strata-engine-git-hip package.
#   strata                 first run: pick a model and install it; later runs: start the server
#   strata --setup         install another model or change settings
#   strata --help          every option (the same ones as upstream's ./setup.sh)
#   strata chat            terminal chat with a running server
# Files live in ${STRATA_HOME:-~/.local/share/strata}; model files go to Strata-data next to app/
# (about 70-120 GB, change it with --data-dir).
set -e

share=/usr/share/strata
lib=/usr/lib/strata
home="${STRATA_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/strata}"
app="$home/app"
stamp="$(cat "$share/PKG_VERSION")"

if [ "$(cat "$app/.pkg-version" 2>/dev/null)" != "$stamp" ]; then
  # 0.2.16 layout: ROOT is app/terminal (setup.py, serve/, tools/), the engine tree sits next to it as app/engine.
  for f in setup.py strata.py requirements.txt chat.py; do rm -f "$app/$f"; done
  for d in CMakeLists.txt cmake serve tools data include src strata_control strata_cli; do
      if [ -L "$app/$d" ]; then rm -f "$app/$d"; fi
  done
  mkdir -p "$app/terminal/engine"
  for e in "$share"/terminal/*; do
      b="$(basename "$e")"
      if [ "$b" = engine ]; then continue; fi
      ln -sfn "$e" "$app/terminal/$b"
  done
  ln -sfn "$share/engine" "$app/engine"
  cp -f "$lib/engine/BUILD.json" "$app/terminal/engine/BUILD.json"
  for b in strata strata-q36 strata-inkling strata-hy4 strata-gguf strata-dequant strata-plan strata-vision strata-vision-hip; do
      if [ -e "$lib/engine/$b" ]; then ln -sf "$lib/engine/$b" "$app/terminal/engine/$b"; fi
  done
  # keep an existing data folder where it is: the new layout looks for Strata-data next to app/terminal, i.e. in app/
  if [ -d "$home/Strata-data" ] && [ ! -e "$app/Strata-data" ]; then
      ln -sfn "$home/Strata-data" "$app/Strata-data"
  fi
  echo "$stamp" > "$app/.pkg-version"
  echo "strata: set up $app (terminal/engine layout)" >&2
  echo "strata: model files go to $app/Strata-data (use --data-dir to put them elsewhere)" >&2
fi

cd "$app/terminal"

export ROCM_PATH="${ROCM_PATH:-/opt/rocm}"
export HIP_PATH="${HIP_PATH:-/opt/rocm}"

if [ "${1:-}" = chat ]; then
  shift
  exec python3 tools/chat.py "$@"
fi

exec python3 -c '
import sys
sys.path.insert(0, ".")
import setup
setup.pip_install = lambda *args, **kwargs: None   # Python packages come from pacman
sys.argv[0] = "strata"
try:
    sys.exit(setup.main())
except KeyboardInterrupt:
    setup.say("\nstopped.")
    sys.exit(1)
' "$@"
EOF
    chmod 755 "${pkgdir}/usr/bin/strata"

    # --- Licenses and docs ---
    cd "${srcdir}/Strata"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 engine/third_party/ggml/LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.ggml"
    install -d "${pkgdir}/usr/share/doc/${pkgname}/docs"
    install -Dm644 -t "${pkgdir}/usr/share/doc/${pkgname}" README.md
    install -Dm644 -t "${pkgdir}/usr/share/doc/${pkgname}/docs" docs/*.md
    ln -s "${pkgname}" "${pkgdir}/usr/share/doc/strata"
}

--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -229,6 +229,38 @@
     crate = "pcre2-sys",
 )
 
+# tree-sitter 0.25's `array.h` type-puns every `Array(T) *` through
+# `Array(void) *`; under -fstrict-aliasing (implied by -O2 and up) that
+# miscompiles, e.g. the tree-sitter-haskell scanner segfaulted:
+# https://github.com/tree-sitter/tree-sitter-haskell/issues/144
+# Fixed upstream in tree-sitter 0.26.4, but the runtime pinned here is 0.25.10
+# and every linked grammar ships its own copy of the header. Annotate the
+# runtime and the grammars pi-ast links (the rest load as WebAssembly).
+[
+    crate.annotation(
+        crate = crate_name,
+        build_script_env = {"CFLAGS": "-fno-strict-aliasing"},
+    )
+    for crate_name in [
+        "tree-sitter",
+        "tree-sitter-bash",
+        "tree-sitter-c",
+        "tree-sitter-cpp",
+        "tree-sitter-css",
+        "tree-sitter-diff",
+        "tree-sitter-html",
+        "tree-sitter-java",
+        "tree-sitter-javascript",
+        "tree-sitter-json",
+        "tree-sitter-md",
+        "tree-sitter-python",
+        "tree-sitter-regex",
+        "tree-sitter-rust",
+        "tree-sitter-toml-ng",
+        "tree-sitter-typescript",
+        "tree-sitter-yaml",
+    ]
+]
 use_repo(crate, "crates")
 
 # --- msvc cross toolchain (owned by bazel/toolchains/msvc) ---------------------

++++ b/build.rs
+@@ -253,6 +253,11 @@
+ fn run() {
+     generate_lib();
+ 
++    if std::env::var("LIBOPUS_DYNAMIC").is_ok() || std::env::var("OPUS_DYNAMIC").is_ok() {
++        println!("cargo:rustc-link-lib=dylib=opus");
++        return;
++    }
++

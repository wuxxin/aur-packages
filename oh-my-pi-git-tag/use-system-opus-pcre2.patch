diff --git a/MODULE.bazel b/MODULE.bazel
index 89489f52565..aeb78a3661e 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -192,11 +192,12 @@ crate.from_cargo(
     ],
 )
 
-# opusic-sys builds its bundled Opus via `cmake` and selects Ninja from PATH.
-# The target-specific toolchain keeps MSVC cross builds on the wrapper
-# compiler/linker; CFLAGS keeps Zig cross builds free of host UBSan links.
+# opusic-sys: link Arch's shared /usr/lib/libopus.so instead of building the
+# vendored Opus via cmake. The patch short-circuits its bundled build path when
+# LIBOPUS_DYNAMIC is set; the remaining env keys stay for the non-linux targets.
 crate.annotation(
     build_script_env = {
+        "LIBOPUS_DYNAMIC": "1",
         "CMAKE_TOOLCHAIN_FILE_x86_64_pc_windows_msvc": "$${pwd}/external/+msvc_cc_repository+msvc_cc/toolchain.cmake",
         "CMAKE_TOOLCHAIN_FILE_aarch64_pc_windows_msvc": "$${pwd}/external/+msvc_cc_repository+msvc_cc_arm64/toolchain.cmake",
         "CFLAGS": "-fno-sanitize=undefined",
@@ -204,9 +205,10 @@ crate.annotation(
     },
     crate = "opusic-sys",
     patch_args = ["-p1"],
-    # CMake explicitly installs to lib; the upstream host-Linux lib64 search
-    # points at a nonexistent directory even when cross-compiling for macOS.
-    patches = ["//bazel/patches:opusic-sys-install-libdir.patch"],
+    patches = [
+        "//bazel/patches:opusic-sys-dynamic.patch",
+        "//bazel/patches:opusic-sys-install-libdir.patch",
+    ],
     version = "0.7.5",
 )
 
@@ -245,10 +247,10 @@ crate.annotation(
     deps = ["@@//crates/vendor/grep-searcher:grep-searcher"],
 )
 
-# Release addons must never pick up a host libpcre2 (Homebrew paths leaked into
-# shipped dylibs before); always build the vendored static copy.
+# pcre2-sys: link Arch's shared /usr/lib/libpcre2-8.so (found via pkg-config)
+# instead of building the vendored static copy.
 crate.annotation(
-    build_script_env = {"PCRE2_SYS_STATIC": "1"},
+    build_script_env = {"PCRE2_SYS_STATIC": "0"},
     crate = "pcre2-sys",
 )
 use_repo(crate, "crates")
diff --git a/bazel/patches/opusic-sys-dynamic.patch b/bazel/patches/opusic-sys-dynamic.patch
new file mode 100644
index 00000000000..4bd8bbafd52
--- /dev/null
+++ b/bazel/patches/opusic-sys-dynamic.patch
@@ -0,0 +1,14 @@

pkgname=oh-my-pi-git-tag
_pkgname=oh-my-pi
pkgver=18.13.1.r289.gc7ffd4f
pkgrel=1
pkgdesc="AI coding agent for the terminal — hash-anchored edits, optimized tool harness, LSP, Python SDK, browser extension, subagents, and more (git latest tag)"
arch=('x86_64')
url="https://github.com/can1357/oh-my-pi"
license=('MIT')
provides=("${_pkgname}" "omp" "python-omp-rpc" "python-robomp")
conflicts=("${_pkgname}" "omp" "python-omp-rpc" "python-robomp")
depends=(
    'glibc'
    'opus'
    'pcre2'
    'python'
    'python-fastapi'
    'uvicorn'
    'python-httpx'
    'python-pydantic'
    'python-pydantic-settings'
    'python-dotenv'
    'python-click'
)
optdepends=(
    'chromium: Browser extension integration support'
)
makedepends=(
    'bazel'
    'bun'
    'git'
    'java-environment=21'
    'python-build'
    'python-installer'
    'python-setuptools'
    'python-wheel'
    'zip'
)
options=('!strip')
source=(
    "${_pkgname}::git+https://github.com/can1357/oh-my-pi.git"
    "tree-sitter-no-strict-aliasing.patch"
    "use-system-opus-pcre2.patch"
    "skip-native-embed-for-aur.patch"
    "relative-json-asset-paths.patch"
)
sha256sums=('SKIP'
            '77cb8e75c88b94e0f001529dfb4145fffa762acf2fb719e2ae52f617b60701e3'
            '0bdcc2ee30428eeac189603fbb8579647754c0830b0a1480a10fa5823e532f05'
            '07c53dcc937479c66a2ab5171f4604a132c8ae93d381331d1f9460e5a9155af4'
            '1bb90d0eb4485fbd7ca8aea990ecc0477e44d08cdc76153ba5c4bcc612f1ffd9')

pkgver() {
    cd "${srcdir}/${_pkgname}"
    git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
    cd "${srcdir}/${_pkgname}"

    patch -p1 -i "${srcdir}/skip-native-embed-for-aur.patch"
    patch -p1 -i "${srcdir}/relative-json-asset-paths.patch"
    patch -p1 -i "${srcdir}/use-system-opus-pcre2.patch"
    patch -p1 -i "${srcdir}/tree-sitter-no-strict-aliasing.patch"

    # Bazel 9.x requires JDK <= 25 (JDK 27 removes -Xverify:none). Ensure a compatible JDK is on PATH.
    if [ -d "/usr/lib/jvm/java-21-openjdk/bin" ]; then
        export PATH="/usr/lib/jvm/java-21-openjdk/bin:${PATH}"
    fi

    # Crate annotations change the Bazel crate graph; Cargo.Bazel.lock needs a repin.
    CARGO_BAZEL_REPIN=1 bazel fetch @crates//...
}

build() {
    cd "${srcdir}/${_pkgname}"

    unset CI CC CXX CFLAGS CXXFLAGS LDFLAGS RUSTFLAGS

    if [ -d "/usr/lib/jvm/java-21-openjdk/bin" ]; then
        export PATH="/usr/lib/jvm/java-21-openjdk/bin:${PATH}"
    fi

    bun install --frozen-lockfile
    # Build browser relay extension
    (cd packages/browser-relay && bun run build)

    # rules_rust fetches the pinned nightly rustc and cargo; no host rust toolchain.
    bun ./scripts/bazel-natives.ts linux-x64-baseline linux-x64-modern --dest packages/natives/native

    # The AUR package ships the addons as loose .node files next to the binary
    # instead of embedding them into the standalone executable.
    PI_SKIP_NATIVE_EMBED=1 RELEASE_TARGETS='linux-x64' bun run ci:release:build-binaries

    # Release the server holding an output base under $srcdir.
    bazel shutdown

    # Build Python RPC SDK wheel
    cd "${srcdir}/${_pkgname}/sdk/python/omp-rpc"
    python -m build --wheel --no-isolation

    # Build RoboMP Python package wheel
    cd "${srcdir}/${_pkgname}/python/robomp"
    python -m build --wheel --no-isolation
}

_install_completions() {
    local _omp_bin="$1"
    local _completion_dir="${srcdir}/completions"
    local _runtime_dir="${srcdir}/completion-runtime"

    rm -rf "${_completion_dir}" "${_runtime_dir}"
    mkdir -p "${_completion_dir}" "${_runtime_dir}/home" "${_runtime_dir}/xdg"

    env HOME="${_runtime_dir}/home" XDG_DATA_HOME="${_runtime_dir}/xdg" \
        "${_omp_bin}" completions bash >"${_completion_dir}/omp.bash"
    env HOME="${_runtime_dir}/home" XDG_DATA_HOME="${_runtime_dir}/xdg" \
        "${_omp_bin}" completions zsh >"${_completion_dir}/_omp"
    env HOME="${_runtime_dir}/home" XDG_DATA_HOME="${_runtime_dir}/xdg" \
        "${_omp_bin}" completions fish >"${_completion_dir}/omp.fish"

    install -Dm644 "${_completion_dir}/omp.bash" "${pkgdir}/usr/share/bash-completion/completions/omp"
    install -Dm644 "${_completion_dir}/_omp" "${pkgdir}/usr/share/zsh/site-functions/_omp"
    install -Dm644 "${_completion_dir}/omp.fish" "${pkgdir}/usr/share/fish/vendor_completions.d/omp.fish"
}

package() {
    cd "${srcdir}/${_pkgname}"

    install -Dm755 "packages/coding-agent/binaries/omp-linux-x64" \
        "${pkgdir}/usr/lib/${_pkgname}/omp"
    install -Dm755 "packages/natives/native/pi_natives.linux-x64-baseline.node" \
        "${pkgdir}/usr/lib/${_pkgname}/pi_natives.linux-x64-baseline.node"
    install -Dm755 "packages/natives/native/pi_natives.linux-x64-modern.node" \
        "${pkgdir}/usr/lib/${_pkgname}/pi_natives.linux-x64-modern.node"
    install -dm755 "${pkgdir}/usr/bin"
    ln -s "../lib/${_pkgname}/omp" "${pkgdir}/usr/bin/omp"
    _install_completions "${pkgdir}/usr/lib/${_pkgname}/omp"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

    # Install Browser Relay extension
    install -dm755 "${pkgdir}/usr/share/${_pkgname}"
    cp -r packages/browser-relay/dist/extension "${pkgdir}/usr/share/${_pkgname}/browser-relay"
    install -Dm644 packages/browser-relay/dist/omp-browser-relay-extension.zip \
        "${pkgdir}/usr/share/${_pkgname}/omp-browser-relay-extension.zip"

    # Install Python RPC SDK into system python site-packages
    cd "${srcdir}/${_pkgname}/sdk/python/omp-rpc"
    python -m installer --destdir="${pkgdir}" --prefix=/usr dist/*.whl

    # Copy Python RPC SDK source tree & wheel to /usr/share/oh-my-pi/python/omp-rpc
    # so plugin virtual environments can install it offline
    local _py_src_dir="${pkgdir}/usr/share/${_pkgname}/python/omp-rpc"
    install -dm755 "${_py_src_dir}/dist"
    cp dist/*.whl "${_py_src_dir}/dist/"
    cp -r pyproject.toml README.md src "${_py_src_dir}/"
    rm -rf "${_py_src_dir}/src/omp_rpc.egg-info"

    # Install RoboMP Python package into system python site-packages
    cd "${srcdir}/${_pkgname}/python/robomp"
    python -m installer --destdir="${pkgdir}" --prefix=/usr dist/*.whl
    # Install documentation and examples
    cd "${srcdir}/${_pkgname}"
    install -dm755 "${pkgdir}/usr/share/doc/${_pkgname}"
    cp -r docs/* "${pkgdir}/usr/share/doc/${_pkgname}/"
    find "${pkgdir}/usr/share/doc/${_pkgname}" -type f -exec chmod 644 {} +
    find "${pkgdir}/usr/share/doc/${_pkgname}" -type d -exec chmod 755 {} +
    install -dm755 "${pkgdir}/usr/share/doc/${_pkgname}/examples"
    cp -r packages/coding-agent/examples/* "${pkgdir}/usr/share/doc/${_pkgname}/examples/"
    find "${pkgdir}/usr/share/doc/${_pkgname}/examples" -type f -exec chmod 644 {} +
    find "${pkgdir}/usr/share/doc/${_pkgname}/examples" -type d -exec chmod 755 {} +
}

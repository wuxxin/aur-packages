pkgbase = aoe-git-tag
	pkgdesc = Terminal session manager for AI coding agents (git latest tag)
	pkgver = 1.14.1.r0.g9b0d691
	pkgrel = 1
	url = https://github.com/agent-of-empires/agent-of-empires
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cargo
	makedepends = cmake
	makedepends = git
	makedepends = nodejs
	makedepends = npm
	makedepends = perl
	makedepends = pkgconf
	depends = gcc-libs
	depends = glibc
	depends = openssl
	depends = tmux
	depends = xz
	depends = zlib
	provides = agent-of-empires
	provides = aoe
	conflicts = agent-of-empires

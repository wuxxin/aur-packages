package_strata-engine-git-ggml-hip() {
    pkgdesc="Inference engine for Qwen3.8-Flash-Next, DeepSeek-V4.1-Flash and Qwen3.6-35B (HIP/ROCm accelerated, shared libggml build)"
    depends=(
        'libggml-git-hip' 'llama.cpp-git-ggml-hip'
        'hip-runtime-amd' 'hipblas' 'hipblaslt' 'rocblas' 'openblas' 'gcc-libs'
        'python' 'python-numpy' 'python-jinja' 'python-regex' 'python-yaml'
        'python-tqdm' 'python-requests' 'python-pillow' 'python-psutil'
    )
    optdepends=(
        'cmake: recompile the engine when your GPU is outside the architectures built here'
        'ninja: recompile the engine when your GPU is outside the architectures built here'
        'gcc: recompile the engine when your GPU is outside the architectures built here'
        'nodejs: run npx-based MCP servers from the web chat'
    )
    provides=('strata-engine' 'strata-engine-git' 'strata-engine-hip')
    conflicts=('strata-engine' 'strata-engine-git' 'strata-engine-hip')

    local _share="${pkgdir}/usr/share/strata"
    local _engine="${pkgdir}/usr/lib/strata/engine"
    install -d "${_share}" "${_engine}" "${pkgdir}/usr/bin"

    # --- Read-only application tree ---
    cd "${srcdir}/Strata"
    cp -r serve tools data include src third_party strata_control "${_share}/"
    install -Dm644 -t "${_share}" CMakeLists.txt setup.py chat.py requirements.txt

    # llama.cpp at the pinned commit for downstream tools / potential recompile
    install -d "${_share}/third_party/llama.cpp"
    git -C "${srcdir}/llama.cpp" archive HEAD | tar -x --no-same-owner -C "${_share}/third_party/llama.cpp"
    (
        cd "${_share}/third_party/llama.cpp"
        rm -rf docs media models tests benches pocs examples tools/ui scripts ci skills app
    )

    # --- Compiled engine and vision binaries ---
    install -Dm755 "${srcdir}/build_strata_hip/strata" "${_engine}/strata"
    patchelf --remove-rpath "${_engine}/strata"
    install -Dm755 "${srcdir}/build_strata_vision_hip/bin/strata-vision-hip" "${_engine}/strata-vision-hip"
    ln -sf strata-vision-hip "${_engine}/strata-vision"

    # --- Generate BUILD.json metadata ---
    local _STRATA_WHITELIST="gfx1100;gfx1101;gfx1102;gfx1103;gfx1150;gfx1151;gfx1152;gfx1200;gfx1201;gfx1010;gfx1011;gfx1012;gfx1030;gfx1031;gfx1032;gfx1034"
    local _STRATA_HIP_ARCHS=""
    local _tgt="${GPU_TARGETS:-}"
    if [[ -z "$_tgt" ]]; then
        _tgt=$(rocm-supported-gfx 2>/dev/null || echo "gfx1100;gfx1201")
    fi
    local _a
    for _a in ${_tgt//;/ }; do
        if [[ ";${_STRATA_WHITELIST};" == *";${_a};"* ]]; then
            _STRATA_HIP_ARCHS="${_STRATA_HIP_ARCHS:+${_STRATA_HIP_ARCHS};}${_a}"
        fi
    done
    if [[ -z "$_STRATA_HIP_ARCHS" ]]; then
        _STRATA_HIP_ARCHS="gfx1100;gfx1201"
    fi

    cd "${_share}"
    PYTHONDONTWRITEBYTECODE=1 python - "${_STRATA_HIP_ARCHS}" "${_engine}/BUILD.json" <<'PYEOF'
import json, sys
sys.path.insert(0, ".")
import setup

archs = [a.strip() for a in sys.argv[1].replace(",", ";").split(";") if a.strip()]
meta = {
    "source": "local-hip",
    "backend": "hip",
    "version": setup.source_version(),
    "archs": archs,
    "vision": "gpu",
    "vision_archs": archs,
    "lib_dirs": ["/opt/rocm/lib"],
    "src": setup.source_hash(setup.ENGINE_SOURCES),
    "vision_src": setup.source_hash(setup.VISION_SOURCES),
}
with open(sys.argv[2], "w", encoding="utf-8") as f:
    json.dump(meta, f, indent=1)
PYEOF

    echo "${pkgver}-${pkgrel}" >"${_share}/PKG_VERSION"

    # --- Launcher script ---
    cat >"${pkgdir}/usr/bin/strata" <<'EOF'
#!/bin/bash
# Launcher for the strata-engine-git-ggml-hip package.
#   strata                 first run: pick a model and install it; later runs: start the server
#   strata --setup         install another model or change settings
#   strata --help          every option (the same ones as upstream's ./setup.sh)
#   strata chat            terminal chat with a running server
# Files live in ${STRATA_HOME:-~/.local/share/strata}; model files go to Strata-data next to app/
# (about 70-120 GB, change it with --data-dir).
set -e

share=/usr/share/strata
lib=/usr/lib/strata
home="${STRATA_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/strata}"
app="$home/app"
stamp="$(cat "$share/PKG_VERSION")"

if [ "$(cat "$app/.pkg-version" 2>/dev/null)" != "$stamp" ]; then
  mkdir -p "$app/engine"
  for f in setup.py chat.py requirements.txt; do
    cp -f "$share/$f" "$app/$f"
  done
  for d in CMakeLists.txt serve tools data include src third_party strata_control; do
    ln -sfn "$share/$d" "$app/$d"
  done
  cp -f "$lib/engine/BUILD.json" "$app/engine/BUILD.json"
  for b in strata strata-vision strata-vision-hip; do
    if [ -e "$lib/engine/$b" ]; then ln -sf "$lib/engine/$b" "$app/engine/$b"; fi
  done
  echo "$stamp" > "$app/.pkg-version"
  echo "strata: set up $app" >&2
  echo "strata: model files go to $home/Strata-data (use --data-dir to put them elsewhere)" >&2
fi

cd "$app"

export ROCM_PATH="${ROCM_PATH:-/opt/rocm}"
export HIP_PATH="${HIP_PATH:-/opt/rocm}"

if [ "${1:-}" = chat ]; then
  shift
  exec python3 chat.py "$@"
fi

exec python3 -c '
import sys
sys.path.insert(0, ".")
import setup
setup.pip_install = lambda *args, **kwargs: None   # Python packages come from pacman
sys.argv[0] = "strata"
try:
    sys.exit(setup.main())
except KeyboardInterrupt:
    setup.say("\nstopped.")
    sys.exit(1)
' "$@"
EOF
    chmod 755 "${pkgdir}/usr/bin/strata"

    # --- Licenses and docs ---
    cd "${srcdir}/Strata"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 third_party/ggml/LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.ggml"
    install -Dm644 "${srcdir}/llama.cpp/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.llama.cpp"
    install -d "${pkgdir}/usr/share/doc/${pkgname}/docs"
    install -Dm644 -t "${pkgdir}/usr/share/doc/${pkgname}" README.md SECURITY.md
    install -Dm644 -t "${pkgdir}/usr/share/doc/${pkgname}/docs" docs/*.md
    ln -s "${pkgname}" "${pkgdir}/usr/share/doc/strata"
}

 # the MMQ instances to build and where the trellis (Gyro) variants come from: the vendored ggml-cuda-tq folder, a fork's ggml, or the overlay of a STRATA_GGML_DIR llama.cpp
diff --git a/src/platform/ggml_cpu_shim.cpp b/src/platform/ggml_cpu_shim.cpp
new file mode 100644
index 000000000..201999eb3
--- /dev/null
+++ b/src/platform/ggml_cpu_shim.cpp
@@ -0,0 +1,159 @@
+#include <ggml.h>
+#include <ggml-backend.h>
+#include <ggml-cpu.h>
+#include <dlfcn.h>
+#include <mutex>
+#include <cstdlib>
+
+extern "C" {
+
+static void * get_cpu_backend_handle() {
+    static void * cpu_handle = nullptr;
+    static std::once_flag flag;
+    std::call_once(flag, []() {
+        void * sym = dlsym(RTLD_DEFAULT, "ggml_get_type_traits_cpu");
+        if (sym && sym != (void*)ggml_get_type_traits_cpu) {
+            cpu_handle = RTLD_DEFAULT;
+            return;
+        }
+
+        // Allow explicit user override via environment variable
+        const char * override_variant = std::getenv("GGML_CPU_VARIANT");
+        if (override_variant && override_variant[0] != '\0') {
+            char custom_path[256];
+            snprintf(custom_path, sizeof(custom_path), "/usr/lib/ggml/libggml-cpu-%s.so", override_variant);
+            void * h = dlopen(custom_path, RTLD_NOW | RTLD_GLOBAL);
+            if (h) {
+                cpu_handle = h;
+                return;
+            }
+        }
+
+        const char * paths[] = {
+            "/usr/lib/ggml/libggml-cpu-zen4.so",
+            "/usr/lib/ggml/libggml-cpu-sapphirerapids.so",
+            "/usr/lib/ggml/libggml-cpu-cooperlake.so",
+            "/usr/lib/ggml/libggml-cpu-icelake.so",
+            "/usr/lib/ggml/libggml-cpu-cascadelake.so",
+            "/usr/lib/ggml/libggml-cpu-cannonlake.so",
+            "/usr/lib/ggml/libggml-cpu-skylakex.so",
+            "/usr/lib/ggml/libggml-cpu-alderlake.so",
+            "/usr/lib/ggml/libggml-cpu-haswell.so",
+            "/usr/lib/ggml/libggml-cpu-piledriver.so",
+            "/usr/lib/ggml/libggml-cpu-ivybridge.so",
+            "/usr/lib/ggml/libggml-cpu-sandybridge.so",
+            "/usr/lib/ggml/libggml-cpu-sse42.so",
+            "/usr/lib/ggml/libggml-cpu-x64.so",
+            nullptr
+        };
+
+        int best_score = 0;
+        const char * best_path = nullptr;
+
+        for (int i = 0; paths[i]; ++i) {
+            // Load locally to inspect score
+            void * h = dlopen(paths[i], RTLD_NOW | RTLD_LOCAL);
+            if (h) {
+                typedef int (*score_fn_t)(void);
+                auto score_fn = (score_fn_t) dlsym(h, "ggml_backend_score");
+                int score = score_fn ? score_fn() : 0;
+                if (score > best_score) {
+                    best_score = score;
+                    best_path = paths[i];
+                }
+                dlclose(h);
+            }
+        }
+
+        if (best_path) {
+            cpu_handle = dlopen(best_path, RTLD_NOW | RTLD_GLOBAL);
+        }
+
+        if (!cpu_handle) {
+            const char * fallbacks[] = {
+                "/usr/lib/ggml/libggml-cpu-x64.so",
+                "/usr/lib/ggml/libggml-cpu.so",
+                nullptr
+            };
+            for (int i = 0; fallbacks[i]; ++i) {
+                void * h = dlopen(fallbacks[i], RTLD_NOW | RTLD_GLOBAL);
+                if (h) {
+                    cpu_handle = h;
+                    break;
+                }
+            }
+        }
+    });
+    return cpu_handle;
+}
+
+const struct ggml_type_traits_cpu * ggml_get_type_traits_cpu(enum ggml_type type) {
+    void * handle = get_cpu_backend_handle();
+    if (handle) {
+        typedef const struct ggml_type_traits_cpu * (*fn_t)(enum ggml_type);
+        auto fn = (fn_t) dlsym(handle, "ggml_get_type_traits_cpu");
+        if (fn && fn != ggml_get_type_traits_cpu) return fn(type);
+    }
+    return nullptr;
+}
+
+void ggml_cpu_init(void) {
+    void * handle = get_cpu_backend_handle();
+    if (handle) {
+        typedef void (*fn_t)(void);
+        auto fn = (fn_t) dlsym(handle, "ggml_cpu_init");
+        if (fn && fn != ggml_cpu_init) {
+            fn();
+        }
+    }
+}
+
+int ggml_cpu_has_avx(void) {
+    #if defined(__AVX__)
+    return 1;
+    #else
+    return __builtin_cpu_supports("avx");
+    #endif
+}
+
+int ggml_cpu_has_avx2(void) {
+    #if defined(__AVX2__)
+    return 1;
+    #else
+    return __builtin_cpu_supports("avx2");
+    #endif
+}
+
+int ggml_cpu_has_fma(void) {
+    #if defined(__FMA__)
+    return 1;
+    #else
+    return __builtin_cpu_supports("fma");
+    #endif
+}
+
+int ggml_cpu_has_f16c(void) {
+    #if defined(__F16C__)
+    return 1;
+    #else
+    return __builtin_cpu_supports("f16c");
+    #endif
+}
+
+int ggml_cpu_has_avx512(void) {
+    #if defined(__AVX512F__)
+    return 1;
+    #else
+    return __builtin_cpu_supports("avx512f");
+    #endif
+}
+
+int ggml_cpu_has_bmi2(void) {
+    #if defined(__BMI2__)
+    return 1;
+    #else
+    return __builtin_cpu_supports("bmi2");
+    #endif
+}
+
+}

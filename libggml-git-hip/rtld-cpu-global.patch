+#define DEFINE_GGML_CPU_HAS(fn_name) \
+GGML_BACKEND_API int fn_name(void) { \
+    typedef int (*fn_t)(void); \
+    auto fn = (fn_t) get_cpu_proc_address(#fn_name); \
+    return fn ? fn() : 0; \
+}

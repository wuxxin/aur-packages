+// ---------------------------------------------------------------------------
+// aoe ops via REST API (AOE_DAEMON_URL, default "http://localhost:28080").
+// ---------------------------------------------------------------------------
+
+fn aoe_url() -> String {
+    let u = std::env::var("AOE_DAEMON_URL")
+        .unwrap_or_else(|_| "http://localhost:28080".to_string());
+    u.trim_end_matches('/').to_string()
+}
+
+fn aoe_token() -> Option<String> {
+    std::env::var("AOE_DAEMON_TOKEN")
+        .ok()
+        .map(|t| t.trim().to_string())
+        .filter(|t| !t.is_empty())
+}
+
+fn aoe_req(req: reqwest::RequestBuilder) -> reqwest::RequestBuilder {
+    if let Some(tok) = aoe_token() {
+        req.bearer_auth(tok)
+    } else {
+        req
+    }
+}
+
+async fn aoe_resolve_id(name: &str) -> Option<String> {
+    let cfg = parse_env(name);
+    let explicit_id = cfg.get_or("AOE_SESSION_ID", "").trim().to_string();
+    if !explicit_id.is_empty() {
+        return Some(explicit_id);
+    }
+    let url = format!("{}/api/sessions", aoe_url());
+    let client = reqwest::Client::builder()
+        .timeout(OP_TIMEOUT)
+        .build()
+        .unwrap_or_default();
+    let resp = aoe_req(client.get(&url)).send().await.ok()?;
+    if !resp.status().is_success() {
+        return None;
+    }
+    let val = resp.json::<Value>().await.ok()?;
+    let sessions = val.get("sessions").and_then(|v| v.as_array()).or_else(|| val.as_array())?;
+    for s in sessions {
+        let sid = s.get("id").and_then(|v| v.as_str()).unwrap_or_default();
+        let title = s.get("title").and_then(|v| v.as_str()).unwrap_or_default();
+        let sname = s.get("name").and_then(|v| v.as_str()).unwrap_or_default();
+        let branch = s.get("branch").and_then(|v| v.as_str()).unwrap_or_default();
+        if sid.eq_ignore_ascii_case(name)
+            || title.eq_ignore_ascii_case(name)
+            || sname.eq_ignore_ascii_case(name)
+            || branch.eq_ignore_ascii_case(name)
+        {
+            return Some(sid.to_string());
+        }
+    }
+    None
+}
+
+async fn aoe_agent_running(name: &str) -> bool {
+    aoe_resolve_id(name).await.is_some()
+}
+
+async fn aoe_capture(name: &str, lines: i64) -> String {
+    let Some(id) = aoe_resolve_id(name).await else {
+        return String::new();
+    };
+    let url = format!("{}/api/sessions/{}/output?lines={}&format=text", aoe_url(), id, lines);
+    let client = reqwest::Client::builder()
+        .timeout(Duration::from_secs(8))
+        .build()
+        .unwrap_or_default();
+    match aoe_req(client.get(&url)).send().await {
+        Ok(resp) if resp.status().is_success() => resp.text().await.unwrap_or_default(),
+        _ => String::new(),
+    }
+}
+
+async fn aoe_send(name: &str, text: &str) -> (bool, String) {
+    let Some(id) = aoe_resolve_id(name).await else {
+        return (false, "not running in aoe".into());
+    };
+    let url = format!("{}/api/sessions/{}/send", aoe_url(), id);
+    let client = reqwest::Client::builder()
+        .timeout(Duration::from_secs(15))
+        .build()
+        .unwrap_or_default();
+    let body = json!({ "message": text });
+    match aoe_req(client.post(&url)).json(&body).send().await {
+        Ok(resp) if resp.status().is_success() => (true, "sent to aoe".into()),
+        Ok(resp) => (false, format!("aoe send failed ({})", resp.status())),
+        Err(e) => (false, format!("aoe send error: {e}")),
+    }
+}

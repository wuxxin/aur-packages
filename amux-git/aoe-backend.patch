 // ---------------------------------------------------------------------------
+// aoe ops via REST API (AOE_URL, default "http://localhost:8080").
+// ---------------------------------------------------------------------------
+
+fn aoe_url() -> String {
+    let u = std::env::var("AOE_URL")
+        .or_else(|_| std::env::var("AMUX_AOE_URL"))
+        .unwrap_or_else(|_| "http://localhost:8080".to_string());
+    u.trim_end_matches('/').to_string()
+}
+
+async fn aoe_agent_running(name: &str) -> bool {
+    let url = format!("{}/api/sessions?state=live", aoe_url());
+    let client = reqwest::Client::builder()
+        .timeout(OP_TIMEOUT)
+        .build()
+        .unwrap_or_default();
+    match client.get(&url).send().await {
+        Ok(resp) if resp.status().is_success() => {
+            if let Ok(val) = resp.json::<Value>().await {
+                if let Some(arr) = val.as_array() {
+                    return arr.iter().any(|s| {
+                        s.get("name").and_then(|v| v.as_str()) == Some(name)
+                            || s.get("id").and_then(|v| v.as_str()) == Some(name)
+                    });
+                }
+            }
+            false
+        }
+        _ => false,
+    }
+}
+
+async fn aoe_capture(name: &str, lines: i64) -> String {
+    let url = format!("{}/api/sessions/{}/output?lines={}&format=text", aoe_url(), name, lines);
+    let client = reqwest::Client::builder()
+        .timeout(Duration::from_secs(8))
+        .build()
+        .unwrap_or_default();
+    match client.get(&url).send().await {
+        Ok(resp) if resp.status().is_success() => resp.text().await.unwrap_or_default(),
+        _ => String::new(),
+    }
+}
+
+async fn aoe_send(name: &str, text: &str) -> (bool, String) {
+    if !aoe_agent_running(name).await {
+        return (false, "not running in aoe".into());
+    }
+    let url = format!("{}/api/sessions/{}/send", aoe_url(), name);
+    let client = reqwest::Client::builder()
+        .timeout(Duration::from_secs(15))
+        .build()
+        .unwrap_or_default();
+    let body = json!({ "message": text });
+    match client.post(&url).json(&body).send().await {
+        Ok(resp) if resp.status().is_success() => (true, "sent to aoe".into()),
+        Ok(resp) => (false, format!("aoe send failed ({})", resp.status())),
+        Err(e) => (false, format!("aoe send error: {e}")),
+    }
+}
